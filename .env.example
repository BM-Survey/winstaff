# Brevo transactional email — contact form delivery
# Create a key at Brevo → SMTP & API → API Keys
BREVO_API_KEY=

# Sender address. Must be a verified sender (or on a verified domain) in Brevo.
CONTACT_FROM_EMAIL=noreply@winstaffsolutions.com

# Where enquiries are delivered. Defaults to company.email in src/content/site.ts
CONTACT_TO_EMAIL=contact@winstaffsolutions.com
